<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latestMajor</LangVersion>
    <RootNamespace>TokkDb.Assistant.Trace</RootNamespace>
  </PropertyGroup>

  <!--
    §3.1: the trace model and the recorder interface, and nothing else. No behaviour, no
    dependencies, not even the storage contract.

    It is its own project because of a correction rather than a preference. An earlier version of
    the plan had the orchestrator depend on the diagram and the diagram depend on the
    orchestrator, which is not a design weakness but a project reference cycle, and .NET refuses
    to build one. Extracting the trace breaks it - and the extraction stands on its own, because
    the trace has five consumers and not two: the diagram lays it out, the orchestrator writes it,
    the application renders its detail panels, the budget harness reads every figure of §6.2a from
    it, and the engine-backed storage persists it. A type five projects need belongs below all
    five.

    The recorder is split along the same line: the interface is here, so that Storage.Engine can
    satisfy TR-4 without depending on the orchestrator, and the implementation is in Agents, which
    is where the unit of work and the operation are.
  -->

  <ItemGroup>
    <PackageReference Include="Ulid" Version="1.3.4" />
  </ItemGroup>

</Project>
