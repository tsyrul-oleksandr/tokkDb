<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chats="clr-namespace:TokkDb.LLM.Application.Chats"
             xmlns:controls="clr-namespace:TokkDb.LLM.Application.Controls"
             x:Name="ChatPageRoot"
             x:Class="TokkDb.LLM.Application.Chats.ChatPage"
             BackgroundColor="{AppThemeBinding Light=#F7F7F8, Dark=#18181B}">
    <ContentPage.Content>
        <Grid
        RowDefinitions="Auto,*"
        ColumnDefinitions="250,*">

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="16,12"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#202023}"
            Stroke="{AppThemeBinding Light=#E5E5E5, Dark=#303035}"
            StrokeThickness="1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                <Label
                    Text="TokkDb"
                    FontSize="20"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="8"
                    Margin="0,0,20,0"
                    VerticalOptions="Center">

                    <Label
                        Text="●"
                        TextColor="#35A854"
                        FontSize="12"
                        VerticalOptions="Center" />

                    <Label
                        Text="{Binding SelectedProvider}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                        VerticalOptions="Center" />

                    <Label
                        Text="·"
                        TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#777777}" />

                    <Label
                        Text="{Binding Model}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="Copy JSON"
                    Command="{Binding CopyConversationCommand}"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    CornerRadius="7"
                    FontSize="13"
                    BackgroundColor="{AppThemeBinding Light=#EFEFF1, Dark=#303035}"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#EDEDED}" />

                <Button
                    Grid.Column="3"
                    Text="+ New Chat"
                    Command="{Binding NewChatCommand}"
                    Padding="14,7"
                    CornerRadius="7"
                    FontSize="13" />

            </Grid>

        </Border>


        <!-- SIDEBAR -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#202023}"
            Stroke="{AppThemeBinding Light=#E5E5E5, Dark=#303035}"
            StrokeThickness="1">

            <Grid RowDefinitions="Auto,Auto,*">

                <Label
                    Text="CONVERSATIONS"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#777777, Dark=#999999}"
                    Margin="8,4,8,12" />

                <Button
                    Grid.Row="1"
                    Text="+ New chat"
                    Command="{Binding NewChatCommand}"
                    HorizontalOptions="Fill"
                    Padding="12,8"
                    CornerRadius="7"
                    FontSize="13"
                    Margin="0,0,0,12" />
                <!--HorizontalContentAlignment="Start"-->
                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding Conversations}"
                    SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                    SelectionMode="Single">

                    <CollectionView.ItemTemplate>
                        <DataTemplate
                            x:DataType="chats:ChatConversation">

                            <Border
                                Padding="10,9"
                                Margin="0,1"
                                StrokeThickness="0"
                                BackgroundColor="Transparent">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">

                                    <VerticalStackLayout Spacing="3">

                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="13"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Subtitle}"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />

                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Text="x"
                                        Command="{Binding Source={x:Reference ChatPageRoot}, Path=BindingContext.DeleteConversationCommand}"
                                        CommandParameter="{Binding .}"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        Padding="0"
                                        CornerRadius="13"
                                        FontSize="12"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#999999, Dark=#888888}"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Border>


        <!-- CHAT -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowDefinitions="*,Auto"
            Padding="0">

            <!-- MESSAGES -->
            <CollectionView
                x:Name="MessagesView"
                Grid.Row="0"
                ItemsSource="{Binding Messages}"
                SelectionMode="None"
                Margin="0">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="10">

                        <Label
                            Text="TokkDb"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Ask questions about your data"
                            FontSize="15"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#999999}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Try: Show me all customers"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#999999, Dark=#777777}"
                            HorizontalTextAlignment="Center"
                            Margin="0,10,0,0" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="chats:ChatMessage">

                        <Grid Padding="28,12">

                            <!-- USER MESSAGE -->
                            <Border
                                IsVisible="{Binding IsUser}"
                                HorizontalOptions="End"
                                MaximumWidthRequest="700"
                                Padding="14,10"
                                BackgroundColor="{AppThemeBinding Light=#E9E9EB, Dark=#303034}"
                                StrokeThickness="0">

                                <controls:SelectableLabel
                                    Text="{Binding Content}"
                                    FontSize="14" />

                            </Border>


                            <!-- ASSISTANT MESSAGE -->
                            <VerticalStackLayout
                                IsVisible="{Binding IsAssistantText}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="850"
                                Spacing="8">

                                <HorizontalStackLayout Spacing="8">

                                    <Border
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}">

                                        <Label
                                            Text="T"
                                            TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                    <Label
                                        Text="TokkDb"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>

                                <controls:SelectableLabel
                                    Text="{Binding Content}"
                                    FontSize="14" />

                                <!-- Token cost of the turn that produced this reply -->
                                <Label
                                    IsVisible="{Binding HasUsage}"
                                    Text="{Binding Usage.Summary}"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light=#999999, Dark=#777777}" />

                            </VerticalStackLayout>


                            <!-- SYSTEM / ERROR MESSAGE -->
                            <Border
                                IsVisible="{Binding IsSystem}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="850"
                                Padding="14,10"
                                Margin="36,4,0,4"
                                BackgroundColor="{AppThemeBinding Light=#FDECEA, Dark=#2E2020}"
                                Stroke="{AppThemeBinding Light=#F2B8B2, Dark=#5C3A38}"
                                StrokeThickness="1">

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="System"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#C0392B, Dark=#E57373}" />

                                    <controls:SelectableLabel
                                        Text="{Binding Content}"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light=#7A2E26, Dark=#EBB9B4}" />

                                </VerticalStackLayout>

                            </Border>

                            <!-- TOOL CALL -->
                            <Border
                                IsVisible="{Binding IsToolExecution}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="850"
                                Padding="0"
                                Margin="36,4,0,4"
                                BackgroundColor="{AppThemeBinding Light=#F0F0F1, Dark=#252529}"
                                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#38383D}"
                                StrokeThickness="1">

                                <VerticalStackLayout Spacing="0">

                                    <!-- Header: "ToolName Status", status is a link -->
                                    <Grid
                                        ColumnDefinitions="Auto,Auto,Auto,*"
                                        Padding="12,10"
                                        ColumnSpacing="8">

                                        <Label
                                            Text="{Binding ToolExecution.StatusIcon}"
                                            TextColor="{Binding ToolExecution.StatusColor}"
                                            FontSize="13"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding ToolExecution.Name}"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            VerticalOptions="Center" />

                                        <!-- Clickable, link-styled status word -->
                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding ToolExecution.StatusText}"
                                            TextColor="{Binding ToolExecution.StatusColor}"
                                            TextDecorations="Underline"
                                            FontSize="13"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ToolExecution.ToggleCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <Label
                                            Grid.Column="3"
                                            Text="{Binding ToolExecution.ToggleIcon}"
                                            TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"
                                            FontSize="12"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ToolExecution.ToggleCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                    </Grid>

                                    <!-- Collapsible detail: request, response, error -->
                                    <VerticalStackLayout
                                        IsVisible="{Binding ToolExecution.IsExpanded}"
                                        Padding="12,0,12,12"
                                        Spacing="8">

                                        <Label
                                            IsVisible="{Binding ToolExecution.HasArguments}"
                                            Text="Request"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light=#777777, Dark=#999999}" />

                                        <ScrollView
                                            IsVisible="{Binding ToolExecution.HasArguments}"
                                            Orientation="Horizontal"
                                            MaximumHeightRequest="260">
                                            <controls:SelectableLabel
                                                Text="{Binding ToolExecution.Arguments}"
                                                FontFamily="Monospace"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" />
                                        </ScrollView>

                                        <Label
                                            IsVisible="{Binding ToolExecution.HasResponse}"
                                            Text="Response"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light=#777777, Dark=#999999}" />

                                        <ScrollView
                                            IsVisible="{Binding ToolExecution.HasResponse}"
                                            Orientation="Horizontal"
                                            MaximumHeightRequest="320">
                                            <controls:SelectableLabel
                                                Text="{Binding ToolExecution.Response}"
                                                FontFamily="Monospace"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" />
                                        </ScrollView>

                                        <Label
                                            IsVisible="{Binding ToolExecution.HasError}"
                                            Text="Tool execution failed:"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light=#C0392B, Dark=#E57373}" />

                                        <ScrollView
                                            IsVisible="{Binding ToolExecution.HasError}"
                                            Orientation="Horizontal"
                                            MaximumHeightRequest="320">
                                            <controls:SelectableLabel
                                                Text="{Binding ToolExecution.Error}"
                                                FontFamily="Monospace"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light=#C0392B, Dark=#E57373}" />
                                        </ScrollView>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </Border>

                            <!-- RECORD LIST (RecordsDisplayView) -->
                            <Border
                                IsVisible="{Binding IsRecords}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="850"
                                Padding="0"
                                Margin="36,4,0,4"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232327}"
                                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#38383D}"
                                StrokeThickness="1">

                                <VerticalStackLayout Spacing="0">

                                    <Label
                                        Text="{Binding Records.Title}"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Padding="14,12,14,6" />

                                    <!-- Empty state, rendered by the app and never by the model -->
                                    <Label
                                        IsVisible="{Binding Records.IsEmpty}"
                                        Text="{Binding Records.EmptyText}"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light=#777777, Dark=#999999}"
                                        Padding="14,0,14,12" />

                                    <!-- RecordDisplayItemView -->
                                    <CollectionView
                                        IsVisible="{Binding Records.HasRecords}"
                                        ItemsSource="{Binding Records.Records}"
                                        SelectionMode="None">

                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="chats:RecordDisplayItemModel">

                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    Padding="14,8"
                                                    ColumnSpacing="12">

                                                    <!-- DisplayValue: link-like, opens the record -->
                                                    <Label
                                                        Grid.Column="0"
                                                        Text="{Binding DisplayValue}"
                                                        TextColor="{AppThemeBinding Light=#2F6FD0, Dark=#7FB0F5}"
                                                        TextDecorations="Underline"
                                                        FontSize="14"
                                                        LineBreakMode="TailTruncation"
                                                        VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding OpenCommand}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <!-- Additional fields -->
                                                    <CollectionView
                                                        Grid.Column="1"
                                                        IsVisible="{Binding HasAdditionalFields}"
                                                        ItemsSource="{Binding AdditionalFields}"
                                                        SelectionMode="None"
                                                        VerticalOptions="Center">
                                                        <CollectionView.ItemsLayout>
                                                            <LinearItemsLayout
                                                                Orientation="Horizontal"
                                                                ItemSpacing="14" />
                                                        </CollectionView.ItemsLayout>
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="chats:RecordFieldModel">
                                                                <controls:SelectableLabel
                                                                    Text="{Binding Label}"
                                                                    FontSize="12"
                                                                    TextColor="{AppThemeBinding Light=#777777, Dark=#999999}"
                                                                    VerticalOptions="Center" />
                                                            </DataTemplate>
                                                        </CollectionView.ItemTemplate>
                                                    </CollectionView>

                                                </Grid>

                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>

                                    </CollectionView>

                                    <controls:SelectableLabel
                                        IsVisible="{Binding Records.HasNotice}"
                                        Text="{Binding Records.Notice}"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light=#B26B00, Dark=#E0A458}"
                                        Margin="14,0,14,10" />

                                </VerticalStackLayout>

                            </Border>

                            <!-- MODEL REASONING (collapsible) -->
                            <Border
                                IsVisible="{Binding IsReasoning}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="850"
                                Padding="0"
                                Margin="36,4,0,4"
                                BackgroundColor="{AppThemeBinding Light=#F7F5FF, Dark=#211F2B}"
                                Stroke="{AppThemeBinding Light=#D9D2F0, Dark=#3D3652}"
                                StrokeThickness="1">

                                <VerticalStackLayout Spacing="0">

                                    <!-- Header: tap to expand or collapse -->
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        Padding="12,10">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Reasoning.ToggleCommand}" />
                                        </Grid.GestureRecognizers>

                                        <Label
                                            Text="{Binding Reasoning.ToggleIcon}"
                                            FontSize="13"
                                            TextColor="{AppThemeBinding Light=#6B5FA8, Dark=#A79BD8}"
                                            VerticalOptions="Center"
                                            Margin="0,0,10,0" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Reasoning.HeaderText}"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            TextColor="{AppThemeBinding Light=#6B5FA8, Dark=#A79BD8}"
                                            VerticalOptions="Center" />

                                        <ActivityIndicator
                                            Grid.Column="2"
                                            IsVisible="{Binding Reasoning.IsStreaming}"
                                            IsRunning="{Binding Reasoning.IsStreaming}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Color="{AppThemeBinding Light=#6B5FA8, Dark=#A79BD8}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                    <!-- Body: only rendered while expanded -->
                                    <controls:SelectableLabel
                                        IsVisible="{Binding Reasoning.IsExpanded}"
                                        Text="{Binding Reasoning.Content}"
                                        FontSize="13"
                                        FontFamily="Monospace"
                                        TextColor="{AppThemeBinding Light=#4A4458, Dark=#B9B2CC}"
                                        Margin="12,0,12,12" />

                                </VerticalStackLayout>

                            </Border>

                            <!-- WORKFLOW MESSAGE -->
                            <Border
                                IsVisible="{Binding IsWorkflowRole}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="850"
                                Padding="14,12"
                                BackgroundColor="{AppThemeBinding Light=#FFF8E6, Dark=#302A1D}"
                                Stroke="{AppThemeBinding Light=#E5C66B, Dark=#66582C}"
                                StrokeThickness="1">

                                <VerticalStackLayout Spacing="10">
                                    <Label
                                        Text="Workflow"
                                        FontAttributes="Bold"
                                        FontSize="13" />

                                    <controls:SelectableLabel
                                        Text="{Binding Content}"
                                        FontSize="14" />

                                    <CollectionView
                                        IsVisible="{Binding Workflow.HasActions}"
                                        ItemsSource="{Binding Workflow.AvailableActions}"
                                        SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="chats:WorkflowActionModel">
                                                <Button
                                                    Text="{Binding Title}"
                                                    Command="{Binding Source={x:Reference ChatPageRoot}, Path=BindingContext.WorkflowActionCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="12,6"
                                                    FontSize="12" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- BOTTOM AREA -->
            <VerticalStackLayout
                Grid.Row="1"
                Padding="24,10,24,20"
                Spacing="8">

                <!-- STATUS -->
                <Label
                    Text="{Binding ResponseStatus}"
                    FontSize="11"
                    TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                    Margin="4,0" />


                <!-- INPUT -->
                <Border
                    Padding="12,8"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252529}"
                    Stroke="{AppThemeBinding Light=#D5D5D5, Dark=#404047}"
                    StrokeThickness="1">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        RowDefinitions="Auto">

                        <Button
                            Text="Upload"
                            Command="{Binding UploadDocumentCommand}"
                            WidthRequest="72"
                            HeightRequest="42"
                            CornerRadius="12"
                            FontSize="12"
                            VerticalOptions="End"
                            Margin="0,0,10,0" />

                        <Editor
                            x:Name="PromptEditor"
                            Grid.Column="1"
                            Text="{Binding Prompt}"
                            Placeholder="Ask something about your data..."
                            AutoSize="TextChanges"
                            MaximumHeightRequest="120"
                            MinimumHeightRequest="42"
                            BackgroundColor="Transparent"
                            FontSize="14"
                            Margin="0,0,10,0" />

                        <Button
                            Grid.Column="2"
                            Text="↑"
                            Command="{Binding SendCommand}"
                            WidthRequest="42"
                            HeightRequest="42"
                            CornerRadius="21"
                            FontSize="18"
                            VerticalOptions="End" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </Grid>

    </Grid>
    </ContentPage.Content>
</ContentPage>